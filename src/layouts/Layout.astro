---
import '@fontsource/space-grotesk/400.css';
import '@fontsource/space-grotesk/500.css';
import '@fontsource/space-grotesk/600.css';
import '@fontsource/space-grotesk/700.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/400-italic.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700-italic.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import 'katex/dist/katex.min.css';
import '../styles/global.css';
import { site } from '../data/site';
import Icon from '../components/Icon.astro';
interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  publishedTime?: string;
  tags?: string[];
  schema?: Record<string, unknown> | Record<string, unknown>[];
}
const { title = 'Home', description = site.description, ogImage = '/og.png', type = 'website', noindex = false, publishedTime, tags = [], schema } = Astro.props;
const path = Astro.url.pathname;
const fullTitle = title === 'Home' ? site.name : `${title} · ${site.name}`;
const canonical = new URL(path, Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);
const socials = site.socials.map((s) => s.url);
const baseSchema: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: site.name,
    jobTitle: site.role,
    url: Astro.site?.toString(),
    email: `mailto:${site.email}`,
    sameAs: socials,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: site.name,
    url: Astro.site?.toString(),
  },
];
const extraSchema = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
const jsonLd = [...baseSchema, ...extraSchema];
const navigation = [{ title: 'Home', href: '/' }, { title: 'Projects', href: '/projects/' }, { title: 'Blogs', href: '/blogs/' }, { title: 'About', href: '/about/' }, { title: 'Contact', href: '/contact/' }];
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    <meta name="theme-color" content="#17181e" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={fullTitle} />
    {type === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {type === 'article' && <meta property="article:author" content={site.name} />}
    {type === 'article' && tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} — Blogs`} href={new URL('/rss.xml', Astro.site)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
    <title>{fullTitle}</title>
    <script is:inline>
      try { document.documentElement.dataset.theme = localStorage.getItem('theme') === 'light' ? 'light' : 'dark'; } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="shell">
      <header class="site-header">
        <a href="/" class="brand" aria-label={`${site.name}, home`}><span class="brand-name">{site.name}</span></a>
        <nav aria-label="Main navigation">
          {navigation.map((item) => <a href={item.href} aria-current={(item.href === '/' ? path === '/' : path.startsWith(item.href)) ? 'page' : undefined}>{item.title}</a>)}
        </nav>
        <a class="ticket-btn nav-cta" href={site.resumeSite} target="_blank" rel="noopener noreferrer">Resume</a>
        <div class="header-actions"><a class="icon-button rss-button" href="/rss.xml" target="_blank" rel="noopener noreferrer" aria-label="RSS feed" title="RSS feed"><Icon name="rss" size={18} /></a>
        <button class="theme-button icon-button" aria-label="Switch to light theme" title="Switch theme"><span class="sun-icon"><Icon name="sun" size={18} /></span><span class="moon-icon"><Icon name="moon" size={18} /></span></button></div>
      </header>
      <main id="main"><slot /></main>
      <footer class="site-footer"><span>&copy; {new Date().getFullYear()} {site.name} · Crafted with <svg class="pixel-heart" width="15" height="13" viewBox="0 0 7 6" shape-rendering="crispEdges" aria-label="love"><path fill="#ff5b5b" d="M1 0h2v1H1zM4 0h2v1H4zM0 1h7v2H0zM1 3h5v1H1zM2 4h3v1H2zM3 5h1v1H3z" /></svg> using <a href="https://astro.build/" target="_blank" rel="noopener noreferrer">Astro</a>.</span><a href="#top" id="back-top">Back to top <span aria-hidden="true">↑</span></a></footer>
    </div>
    <script>
      const themeButton = document.querySelector<HTMLButtonElement>('button.theme-button');
      function syncThemeLabel() {
        themeButton?.setAttribute('aria-label', `Switch to ${document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark'} theme`);
      }
      syncThemeLabel();
      themeButton?.addEventListener('click', () => {
        const theme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = theme;
        try { localStorage.setItem('theme', theme); } catch {}
        syncThemeLabel();
      });
      document.querySelector('#back-top')?.addEventListener('click', (event) => {
        event.preventDefault();
        window.scrollTo({ top: 0, behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth' });
      });
    </script>
  </body>
</html>
