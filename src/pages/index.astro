---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import WorkCard from '../components/WorkCard.astro';
import { site } from '../data/site';
import { getCollection } from 'astro:content';
const recentPosts = (await getCollection('posts')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);
const github = site.socials.find((s) => s.icon === 'github');
const linkedin = site.socials.find((s) => s.icon === 'linkedin');
const x = site.socials.find((s) => s.icon === 'x');
---
<Layout>
  <section class="intro hero-grid">
    <div class="hero-copy">
      <h1>Hi, I'm {site.name}.</h1>
      <p><strong>{site.role}</strong>, working on distributed systems and data platforms.</p>
      <p>I enjoy building reliable, high-throughput software, from event-driven pipelines to thoughtful developer tooling.</p>
      <p>I write about the interesting bits. Always happy to discuss them with people working on similar problems.</p>
      <ul class="intro-facts">
        <li><span class="fact-emoji">👨🏻‍💻</span><span>I have a passion for problem solving and competitive programming.</span></li>
        <li><span class="fact-emoji">🌱</span><span>I'm currently learning Golang.</span></li>
      </ul>
      <div class="welcome-actions">
        {github?.url && <span class="tbtn"><a href={github.url} target="_blank" rel="noopener noreferrer" aria-label="GitHub profile"><Icon name="github" size={19} /></a></span>}
        {linkedin?.url && <span class="tbtn"><a href={linkedin.url} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn profile"><Icon name="linkedin" size={19} /></a></span>}
        {x?.url && <span class="tbtn"><a href={x.url} target="_blank" rel="noopener noreferrer" aria-label="X profile"><Icon name="x" size={19} /></a></span>}
        {site.email && <a class="ticket-btn" href={`mailto:${site.email}`}>Say hello</a>}
      </div>
    </div>
    <div class="tcard art"><div class="tcard-in art-in">
      <div class="orbital-art compact" aria-hidden="true"><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="orbit orbit-three"></div><div class="orbit orbit-four"></div><div class="orbit orbit-five"></div><div class="planet"></div><div class="satellite"></div></div>
      <span class="mono art-tag">Stay curious.</span>
    </div></div>
  </section>
  <section class="section-block home-toolbox" aria-label="Toolbox">
    <span class="eyebrow">TOOLBOX</span>
    <div class="toolbox-groups">{site.tools.map((group) => <div class="stack-group"><h3>{group.label}</h3><div class="tags">{group.items.map((tool) => <span>{tool}</span>)}</div></div>)}</div>
  </section>
  <section class="section-block home-work" aria-labelledby="work-title"><div class="section-heading"><div><span class="eyebrow">FROM GITHUB</span><h2 id="work-title">Selected work<span class="heading-dot">.</span></h2></div><a class="text-link" href="/work/">See all work <Icon name="right" size={16} /></a></div><div class="work-list">{site.work.filter((p) => p.name !== 'RFID-Attendance-system').slice(0, 3).map((project) => <WorkCard {...project} />)}</div></section>
  <section class="section-block home-posts" aria-labelledby="posts-title"><div class="section-heading"><div><span class="eyebrow">FROM THE NOTEBOOK</span><h2 id="posts-title">Latest posts<span class="heading-dot">.</span></h2></div><a class="text-link" href="/posts/">See all posts <Icon name="right" size={16} /></a></div><div class="work-list">{recentPosts.map((post) => <a class="tcard work-card" href={`/posts/${post.id}/`}><div class="tcard-in work-in"><div class="work-copy"><h3>{post.data.title}</h3><p>{post.data.description}</p><span class="mono work-meta">{post.data.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' })} · {post.data.category} · {post.data.readTime}</span></div><span class="work-arrow" aria-hidden="true"><Icon name="arrow" size={20} /></span></div></a>)}</div></section>
</Layout>
