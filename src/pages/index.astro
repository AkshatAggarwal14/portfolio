---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import WorkCard from '../components/WorkCard.astro';
import { site } from '../data/site';
import { getCollection } from 'astro:content';
const recentPosts = (await getCollection('posts')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order).slice(0, 3);
const github = site.socials.find((s) => s.icon === 'github');
const linkedin = site.socials.find((s) => s.icon === 'linkedin');
const x = site.socials.find((s) => s.icon === 'x');
---
<Layout>
  <div class="bento top-grid">
    <section class="intro intro-col">
      <h1>Hi, I'm {site.name}.</h1>
      <p><strong>{site.role}</strong>, working on distributed systems and data platforms.</p>
      <p>I enjoy building reliable, high-throughput software, from event-driven pipelines to thoughtful developer tooling.</p>
      <p>I write about the interesting bits. Always happy to discuss them with people working on similar problems.</p>
      <ul class="intro-facts">
        <li><span class="fact-emoji">👨🏻‍💻</span><span>I have a passion for problem solving and <a href="/about/#cp">competitive programming</a>.</span></li>
        <li><span class="fact-emoji">🌱</span><span>I'm currently learning Golang.</span></li>
      </ul>
      <div class="welcome-actions">
        {github?.url && <span class="tbtn"><a href={github.url} target="_blank" rel="noopener noreferrer" aria-label="GitHub profile"><Icon name="github" size={19} /></a></span>}
        {linkedin?.url && <span class="tbtn"><a href={linkedin.url} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn profile"><Icon name="linkedin" size={19} /></a></span>}
        {x?.url && <span class="tbtn"><a href={x.url} target="_blank" rel="noopener noreferrer" aria-label="X profile"><Icon name="x" size={19} /></a></span>}
        {site.email && <a class="ticket-btn" href={`mailto:${site.email}`}>Say hello</a>}
      </div>
    </section>
    <div class="tcard stack-tile"><div class="tcard-in">
      <h2>Stack & tools</h2>
      {site.tools.map((group) => <div class="stack-group"><h3>{group.label}</h3><div class="tags">{group.items.map((tool) => <span>{tool}</span>)}</div></div>)}
    </div></div>
  </div>
  <section class="section-block home-work" aria-labelledby="work-title"><div class="section-heading"><div><span class="eyebrow">FROM GITHUB</span><h2 id="work-title">Selected work<span class="heading-dot">.</span></h2></div><a class="text-link" href="/projects/">See all work <Icon name="right" size={16} /></a></div><div class="work-list">{projects.map((p) => <WorkCard name={p.data.repo} title={p.data.title} slug={p.id} description={p.data.description} url={p.data.url} language={p.data.language} stars={p.data.stars} demo={p.data.demo} />)}</div></section>
  <section class="section-block home-posts" aria-labelledby="posts-title"><div class="section-heading"><div><span class="eyebrow">FROM THE NOTEBOOK</span><h2 id="posts-title">Latest blogs<span class="heading-dot">.</span></h2></div><a class="text-link" href="/blogs/">See all blogs <Icon name="right" size={16} /></a></div><div class="work-list">{recentPosts.map((post) => <a class="tcard work-card" href={`/blogs/${post.id}/`}><div class="tcard-in work-in"><div class="work-copy"><h3>{post.data.title}</h3><p>{post.data.description}</p><span class="mono work-meta">{post.data.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' })} · {post.data.category} · {post.data.readTime}</span></div><span class="work-arrow" aria-hidden="true"><Icon name="arrow" size={20} /></span></div></a>)}</div></section>
</Layout>
