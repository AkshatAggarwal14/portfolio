---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths() { return (await getCollection('projects')).map((project) => ({ params: { slug: project.id }, props: { project } })); }
const { project } = Astro.props;
const { Content } = await render(project);
const data = project.data;
const pageUrl = new URL(`/projects/${project.id}/`, Astro.site).toString();
const projectSchema = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: data.title,
  description: data.description,
  url: pageUrl,
  author: { '@type': 'Person', name: 'Akshat Aggarwal', url: Astro.site?.toString() },
  keywords: data.stack.join(', '),
};
---
<Layout title={data.title} description={data.description} type="article" ogImage={`/projects/og/${project.id}.png`} tags={data.stack} schema={projectSchema}>
  <article class="article-wrap">
    <a class="text-link back-link" href="/projects/"><span class="back-arrow">&larr;</span> All projects</a>
    <header class="page-heading project-head">
      <span class="eyebrow">{data.language}{typeof data.stars === 'number' ? ` · ★ ${data.stars}` : ''}</span>
      <h1>{data.title}<span class="heading-dot">.</span></h1>
      <p>{data.description}</p>
      <p class="project-links"><a href={data.url} target="_blank" rel="noopener noreferrer">Repository</a>{data.demo ? <span> · <a href={data.demo} target="_blank" rel="noopener noreferrer">Live demo</a></span> : null}</p>
    </header>
    <div class="prose">
      <h2>About</h2>
      <Content />
      {data.images ? <div><h2>Screens</h2><div class="shot-grid">{data.images.map((img) => <figure><img src={img.src} alt={img.alt} loading="lazy" />{img.caption ? <figcaption>{img.caption}</figcaption> : null}</figure>)}</div></div> : null}
      <h2>Stack</h2>
      <div class="tags">{data.stack.map((s) => <span>{s}</span>)}</div>
    </div>
    <div class="article-end"><span class="tiny-star">*</span><a href="/contact/" class="text-link">Have a thought? Let's connect &rarr;</a></div>
  </article>
</Layout>
