---
import Layout from '../layouts/Layout.astro';
import CpSection from '../components/CpSection.astro';
import { site } from '../data/site';
---
<Layout title="About">
  <header class="page-heading resume-heading"><div><span class="eyebrow">THE STORY SO FAR</span><h1>About me<span class="heading-dot">.</span></h1><p>Work, community, education, skills, and wins.</p></div></header>
  <article class="tcard"><div class="tcard-in resume-sheet">
    <section class="resume-section"><h3 class="eyebrow">WORK</h3><div class="timeline">{site.resume.experience.map((job) => <div class={job.roles.some((r) => r.period.includes('Present')) ? 'timeline-entry current' : 'timeline-entry'}><div class="job-heading"><h4>{job.url ? <a href={job.url} target="_blank" rel="noopener noreferrer">{job.company}</a> : job.company}</h4><span class="mono">{job.location}</span></div>{job.roles.map((r) => <div class="timeline-role"><div class="job-subheading"><strong>{r.role}</strong><span class="mono">{r.period}</span></div><ul>{r.details.map((d) => <li set:html={d} />)}</ul></div>)}</div>)}</div></section>
    <section class="resume-section"><h3 class="eyebrow">COMMUNITY</h3><div class="timeline">{site.resume.community.map((c) => <div class="timeline-entry"><div class="job-heading"><h4>{('url' in c && c.url) ? <a href={c.url} target="_blank" rel="noopener noreferrer">{c.org}</a> : c.org}</h4></div>{c.roles.map((r) => <div class="timeline-role"><div class="job-subheading"><strong>{('cert' in r && r.cert) ? <a href={r.cert} target="_blank" rel="noopener noreferrer">{r.role}</a> : r.role}</strong>{r.period ? <span class="mono">{r.period}</span> : null}</div><ul><li>{r.details}</li></ul></div>)}</div>)}</div></section>
    <section class="resume-section"><h3 class="eyebrow">EDUCATION</h3><div>{site.resume.education.map((e) => <div class="edu-entry"><div class="job-heading"><h4>{('url' in e && e.url) ? <a href={e.url} target="_blank" rel="noopener noreferrer">{e.title}</a> : e.title}</h4><span class="mono">{e.period}</span></div><p>{e.institution}</p><p class="edu-detail">{e.detail}</p></div>)}</div></section>
  </div></article>
  <section class="section-block" aria-labelledby="skills-title"><div class="section-heading"><div><span class="eyebrow">STACK</span><h2 id="skills-title">Skills<span class="heading-dot">.</span></h2></div></div><div class="tcard"><div class="tcard-in about-card"><div class="resume-skills">{site.resume.skills.map((g) => <div><h4>{g.label}</h4><div class="tags">{g.items.map((s) => <span>{s}</span>)}</div></div>)}</div></div></div></section>
  <section class="section-block" aria-labelledby="wins-title"><div class="section-heading"><div><span class="eyebrow">WINS</span><h2 id="wins-title">Achievements<span class="heading-dot">.</span></h2></div></div><div class="tcard"><div class="tcard-in about-card"><div class="timeline">{site.resume.achievements.map((a) => <div class="timeline-entry"><div class="job-heading"><h4><a href={a.url} target="_blank" rel="noopener noreferrer">{a.title}</a></h4><span class="mono">{a.period}</span></div><p class="win-detail">{a.detail}</p></div>)}</div></div></div></section>
  <CpSection />
</Layout>
